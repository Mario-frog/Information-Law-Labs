# Lab 6 - локальні правила Suricata (IPS). Розмістити у /etc/suricata/rules/local.rules
# Мережа лабораторії: HOME_NET = 192.168.56.0/24 (host-only), захищена машина 192.168.56.20
# У режимі IDS використовується action "alert"; у режимі IPS - "drop".

# 1. Сканування портів: багато SYN від одного джерела за короткий час
drop tcp any any -> $HOME_NET any (msg:"LAB6 Port scan: many SYN from one source"; flags:S,12; threshold:type both, track by_src, count 30, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)

# 2. DoS (SYN flood) на веб-сервіс
drop tcp any any -> $HOME_NET 80 (msg:"LAB6 DoS: SYN flood to port 80"; flags:S,12; threshold:type both, track by_dst, count 300, seconds 1; classtype:attempted-dos; sid:1000002; rev:1;)

# 3. SQL-ін'єкція: UNION SELECT в URI
drop http any any -> $HOME_NET any (msg:"LAB6 SQLi: UNION SELECT in URI"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:1000003; rev:1;)

# 4. SQL-ін'єкція: типовий тавтологічний payload  ' OR 1=1
drop http any any -> $HOME_NET any (msg:"LAB6 SQLi: OR 1=1 tautology"; flow:established,to_server; http.uri; content:"or"; nocase; content:"1=1"; nocase; distance:0; classtype:web-application-attack; sid:1000004; rev:1;)

# 5. Інструмент sqlmap за User-Agent (легко обходиться - лише для демонстрації)
alert http any any -> $HOME_NET any (msg:"LAB6 Tool: sqlmap user-agent"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:1000005; rev:1;)

# 6. Експлойт vsftpd 2.3.4 (backdoor): USER із символами ":)"
drop tcp any any -> $HOME_NET 21 (msg:"LAB6 Exploit: vsftpd 2.3.4 backdoor trigger"; flow:established,to_server; content:"USER "; depth:5; content:"|3a 29|"; distance:0; classtype:attempted-admin; sid:1000006; rev:1;)

# 7. Підключення до порту бекдору 6200 (після спрацювання експлойта)
alert tcp any any -> $HOME_NET 6200 (msg:"LAB6 Exploit: connection to vsftpd backdoor port 6200"; flow:to_server; flags:S; classtype:trojan-activity; sid:1000007; rev:1;)
